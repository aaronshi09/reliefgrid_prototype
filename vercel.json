{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{index.html,longisland_facilities.geojson,tracts_drive_diagnostics.geojson,tracts_walk_diagnostics.geojson,diagnostics_drive.json,diagnostics_walk.json}"
    }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
