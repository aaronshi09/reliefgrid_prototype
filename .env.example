# ReliefGrid AI configuration — copy to .env for local development.
# NEVER commit .env or real keys. On a hosting platform, set these as
# environment variables / secrets in the project settings instead.

# Resource Navigator (consumer "Find Help"). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Ask ReliefGrid (government / nonprofit analytics). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Location-aware Find Help: real walking/driving travel times, route lines and
# landmark search via openrouteservice (OpenStreetMap data). Free key at
# https://openrouteservice.org/dev/#/signup — keep it server-side only.
# Towns/ZIP codes (bundled Census data) and street addresses (U.S. Census
# Geocoder) work without any key.
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here
# Optional: destinations per travel-time request (default 25, max 50)
# ORS_MAX_DESTINATIONS=25

# Optional model overrides (defaults are set in server/ai/config.js)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Gemini thinking level: minimal | low | medium | high (unset = model default)
# GEMINI_THINKING_LEVEL=
# OPENAI_MODEL=gpt-6-luna
# Optional OpenAI reasoning effort: none | low | medium | high (default low)
# OPENAI_REASONING_EFFORT=low

# Optional: when one provider is unavailable, retry capability-equivalent
# tasks on the other provider (default false).
# AI_ALLOW_FALLBACK=false

# Optional: Google Maps grounding for travel/area context on resource
# detail pages (Gemini only; shown as external information). Default false.
# GEMINI_MAPS_GROUNDING=false

# Optional: allow a separately hosted frontend (e.g. GitHub Pages) to call
# this backend. Comma-separated origins.
# AI_ALLOWED_ORIGINS=https://your-name.github.io

# Optional: per-IP requests per minute (best-effort, per instance). Default 40.
# AI_RATE_LIMIT_PER_MIN=40

# Local dev server port (default 8787)
# PORT=8787
